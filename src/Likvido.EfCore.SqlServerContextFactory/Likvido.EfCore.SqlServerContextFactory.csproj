<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <Import Project="$(ProjectDir)../version.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <!-- AIKIDO-2026-11098: System.IdentityModel.Tokens.Jwt < 8.19.0 can parse stale ArrayPool bytes as
         claims. Microsoft.Data.SqlClient 7 (via EF Core 11) brings in 8.16.0 through
         Microsoft.IdentityModel.Protocols.OpenIdConnect, so pin both above the cutoff, together, to keep
         the Microsoft.IdentityModel packages on one version. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
</Project>
